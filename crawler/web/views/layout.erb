<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= @title || "政策库后台" %></title>
<style>
:root {
  color-scheme: light;
  --bg: #f6f8fb;
  --card: #ffffff;
  --border: #e6e9ef;
  --text: #1a202c;
  --muted: #6b7280;
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --sidebar-bg: #111827;
  --sidebar-text: #9ca3af;
  --green: #059669;
  --radius: 12px;
  --shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 1px 3px rgba(16, 24, 40, .06);
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.6;
  min-height: 100vh;
}
.layout { display: flex; min-height: 100vh; }

.sidebar {
  width: 220px;
  background: var(--sidebar-bg);
  color: var(--sidebar-text);
  padding: 24px 16px;
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}
.sidebar .brand {
  font-size: 17px;
  font-weight: 700;
  color: #fff;
  padding: 0 8px 20px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar .brand .dot {
  width: 9px; height: 9px; border-radius: 50%;
  background: #34d399; box-shadow: 0 0 0 3px rgba(52, 211, 153, .2);
}
.sidebar .nav { display: flex; flex-direction: column; gap: 2px; }
.sidebar .nav a {
  color: var(--sidebar-text);
  text-decoration: none;
  padding: 9px 12px;
  border-radius: 8px;
  font-size: 13.5px;
  transition: background .15s, color .15s;
}
.sidebar .nav a:hover { background: rgba(255,255,255,.06); color: #fff; }
.sidebar .nav a.active { background: var(--primary); color: #fff; font-weight: 600; }
.sidebar .foot {
  margin-top: auto;
  padding: 12px 8px 0;
  border-top: 1px solid rgba(255,255,255,.08);
  font-size: 12px;
  color: #6b7280;
  line-height: 1.7;
}

.main {
  flex: 1;
  padding: 32px 40px;
  max-width: 1280px;
}
.page-head { margin-bottom: 24px; }
.page-head h1 { font-size: 22px; font-weight: 700; margin: 0 0 4px; }
.page-head .sub { color: var(--muted); font-size: 13px; }

.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24px;
  margin-bottom: 20px;
}

.toolbar { display: flex; gap: 12px; align-items: center; margin-bottom: 20px; }
.searchbox { flex: 1; max-width: 440px; position: relative; }
.searchbox input {
  width: 100%;
  padding: 10px 14px 10px 38px;
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 14px;
  font-family: inherit;
  background: var(--card);
  transition: border-color .15s, box-shadow .15s;
}
.searchbox input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
}
.searchbox .icon {
  position: absolute;
  left: 12px; top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
  pointer-events: none;
}

table { width: 100%; border-collapse: collapse; }
thead th {
  text-align: left;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .5px;
  color: var(--muted);
  padding: 10px 16px;
  border-bottom: 1px solid var(--border);
  background: #fafbfd;
}
tbody td {
  padding: 13px 16px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
}
tbody tr:last-child td { border-bottom: none; }
tbody tr { transition: background .12s; }
tbody tr:hover { background: #f8fafd; }
td.title { max-width: 440px; }
td.title a {
  color: var(--text);
  text-decoration: none;
  font-weight: 500;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
td.title a:hover { color: var(--primary); }
td.code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; color: var(--muted); }
td.time { font-size: 12.5px; color: var(--muted); white-space: nowrap; }

.badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.8;
}
.badge.policy { background: #eff6ff; color: #1d4ed8; }
.badge.interpretation { background: #f0fdf4; color: #059669; }
.badge.version { background: #f4f4f5; color: #52525b; }

.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  cursor: pointer;
  transition: background .15s, border-color .15s;
}
.btn:hover { background: #f4f6f9; }
.btn.primary { background: var(--primary); border-color: var(--primary); color: #fff; }
.btn.primary:hover { background: var(--primary-hover); }

.pager { display: flex; align-items: center; justify-content: space-between; margin-top: 16px; }
.pager .info { color: var(--muted); font-size: 13px; }
.pager .controls { display: flex; gap: 8px; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px; }
.form-grid .full { grid-column: 1 / -1; }
.field label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #374151;
  margin-bottom: 6px;
}
.field input[type=text],
.field input[type=number],
.field input[type=datetime-local],
.field select,
.field textarea {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  background: var(--card);
  transition: border-color .15s, box-shadow .15s;
}
.field input:focus, .field select:focus, .field textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
}
.field textarea { min-height: 110px; resize: vertical; }
.field textarea.large { min-height: 320px; font-size: 13px; line-height: 1.7; }

table.kv input[type=text],
table.kv input[type=number],
table.kv input[type=datetime-local],
table.kv select,
table.kv textarea {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  background: var(--card);
  transition: border-color .15s, box-shadow .15s;
}
table.kv input:focus, table.kv select:focus, table.kv textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
}
table.kv textarea { min-height: 110px; resize: vertical; font-size: 13px; line-height: 1.7; }

.actions { display: flex; gap: 10px; align-items: center; }
.divider { border: none; border-top: 1px solid var(--border); margin: 20px 0; }

.article-title { font-size: 20px; font-weight: 700; line-height: 1.5; margin: 0 0 8px; }
.article-meta { display: flex; gap: 16px; flex-wrap: wrap; color: var(--muted); font-size: 13px; margin-bottom: 16px; }
.article-content { line-height: 1.9; color: #1f2937; word-break: break-word; }

.empty { text-align: center; color: var(--muted); padding: 40px 0; }

/* ---- 键值对表(仿 Sinatra 报错页) ---- */
table.kv { width: 100%; border-collapse: collapse; font-size: 13px; }
table.kv th, table.kv td { padding: 8px 14px; border: 1px solid #dfe3e8; text-align: left; vertical-align: top; }
table.kv th {
  width: 160px;
  background: #eef1f5;
  color: #4b5563;
  font-weight: 600;
  white-space: nowrap;
  font-size: 12px;
  letter-spacing: .3px;
}
table.kv td { color: var(--text); word-break: break-word; }
table.kv tr:hover td { background: #f8fafd; }
</style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="brand"><span class="dot"></span>政策库后台</div>
    <nav class="nav">
      <a href="/" class="<%= request.path_info == "/" ? "active" : "" %>">文章列表</a>
    </nav>
    <div class="foot">
      local · content.sqlite<br />
      <%= @footer_info || "" %>
    </div>
  </aside>
  <div class="main">
    <%= yield %>
  </div>
</div>
</body>
</html>
